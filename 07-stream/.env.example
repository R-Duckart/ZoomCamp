# ============================================================================
# 07-Stream Configuration Example
# ============================================================================
# Copy this file to .env and configure as needed
# Most defaults work out of the box for local development

# ============================================================================
# Data Paths
# ============================================================================
# Directory containing mock parquet files for producer
DATA_MOCK_PATH=data_mock

# Directory where consumer writes parquet output
DATA_DEST_PATH=data

# ============================================================================
# Kafka/RedPanda Configuration (External Access)
# ============================================================================
# Use these when running producer/consumer on host machine (outside Docker)
REDPANDA_BROKERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ============================================================================
# Kafka/RedPanda Configuration (Internal Docker Network)
# ============================================================================
# Use these when running services inside Docker containers
REDPANDA_BROKERS_INTERNAL=redpanda:29092
SCHEMA_REGISTRY_URL_INTERNAL=http://redpanda:8081

# ============================================================================
# Kafka Topics and Consumer Groups
# ============================================================================
# Main topic for taxi trip events
KAFKA_TOPIC=taxi-trips

# Consumer group ID for offset management
KAFKA_CONSUMER_GROUP=taxi-consumers

# Test topic (optional, for development)
KAFKA_TOPIC_TEST=test-taxi-trips

# ============================================================================
# Database Configuration (Optional - for Flink jobs)
# ============================================================================
# PostgreSQL settings for testing purposes
# ⚠️ In production, use secure passwords and proper user management
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

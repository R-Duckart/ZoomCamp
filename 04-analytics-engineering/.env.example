# DuckDB local database path (for dev environment)
DUCKDB_PATH=./taxi.duckdb

# Google Cloud Platform Configuration (for prod environment)
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET=your-dataset-name
GCP_LOCATION=europe-west1

# Path to your GCP service account credentials JSON file
# You can use Application Default Credentials (ADC) or a service account key file
# For ADC (recommended): use `gcloud auth application-default login`
# For service account: provide the path to your JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# ============================================================================
# 06-Batch Configuration Example
# ============================================================================
# Copy this file to .env and uncomment ONE of the sections below
# 
# Development uses DuckDB (local database)
# Production uses BigQuery (GCP)

# ============================================================================
# DEVELOPMENT ENVIRONMENT (DuckDB)
# ============================================================================
# Recommended for local testing and development
# Uncomment this section and comment out PRODUCTION below

ENV=dev
DATALAKE_SOURCES=/opt/workspace/datalake/raw/taxi
DB_PATH=/opt/workspace/datawarehouse/duckdb/taxi.duckdb
DB_TABLE=revenue_zone_monthly
DB_SCHEMA=reporting

# ============================================================================
# PRODUCTION ENVIRONMENT (BigQuery)
# ============================================================================
# For production deployments with Google BigQuery
# Ensure GCP credentials file exists before running
# Uncomment this section and comment out DEVELOPMENT above

# ENV=prod
# GOOGLE_APPLICATION_CREDENTIALS=/opt/workspace/gcp-key/application_default_credentials.json
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_BUCKET=your-gcs-temp-bucket
# GCP_DATASET=your_dataset
# DB_TABLE=revenue_zone_monthly
# DATALAKE_SOURCES=gs://your-gcs-bucket/raw/taxi

# Environment configuration example
# Copy this file to .env and fill in your actual values

ENV=prod

# Data sources
DATALAKE_SOURCES=/app/datalake/raw/taxi

# DuckDB configuration
DB_PATH=/app/datawarehouse/duckdb/taxi.duckdb
DB_SCHEMA=reporting
DB_TABLE=yearly_revenue_by_zone

# GCP Configuration (replace with your actual values)
GCP_PROJECT_ID=your-gcp-project-id
GCP_DATASET=marts
GCP_LOCATION=europe-west1
GCP_BUCKET=your-gcs-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=/opt/gcp-key.json/application_default_credentials.json
